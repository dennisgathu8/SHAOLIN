;; Clojure Fortress — shadow-cljs build configuration
;; Zero paid services. Pure ClojureScript. :advanced compilation.

{:source-paths ["src/main" "src/test" "dev"]

 :dependencies [[reagent "1.2.0"]
                [re-frame "1.4.3"]
                [metosin/reitit "0.7.2"]
                [day8.re-frame/test "0.1.5"]]

 :dev-http {8080 "public"}

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"

   :modules
   {:main {:init-fn fortress.core/init!}}

   :devtools
   {:after-load fortress.core/mount-root!
    :preloads [fortress.dev]}

   :compiler-options
   {:optimizations :advanced
    :infer-externs true
    :static-fns true
    :fn-invoke-direct true
    :elide-asserts true}

   :release
   {:build-options
    {:ns-aliases {day8.re-frame.tracing day8.re-frame.tracing-stubs}}}}

  :test
  {:target :node-test
   :output-to "out/test.js"
   :autorun true

   :compiler-options
   {:optimizations :none
    :static-fns true}}}}
