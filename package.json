{
  "name": "fkf-decision-simulator",
  "version": "0.1.0",
  "description": "Interactive Decision-Making Simulator for FKF SportPesa League Players",
  "private": true,
  "scripts": {
    "dev": "npx shadow-cljs watch app",
    "test": "npx shadow-cljs compile test",
    "release": "npx shadow-cljs release app",
    "deploy": "gh-pages -d public",
    "report": "npx shadow-cljs run shadow.cljs.build-report app report.html",
    "security-audit": "bash scripts/security-audit.sh"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "shadow-cljs": "2.28.18"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
